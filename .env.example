# Copy to .env (auto-loaded is optional; config.py reads env vars directly).
# You can also paste your key straight into config.py to run without env vars.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional overrides
# DJANGO_DEBUG=true
# SESSION_IDLE_SECONDS=60
# RETRIEVAL_TOP_K=6
# DATABASE_URL=postgres://user:pass@localhost:5432/continuum
